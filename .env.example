# DATABASE_URL: OBLIGATORIA. La app corre sobre Postgres y no tiene otro
# motor: sin esta variable no arranca. En desarrollo apunta al Postgres del
# docker-compose.yml de la raíz (`docker compose up -d`).
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# External Database URL de cada entorno, para los scripts de operación
# (promover_demo.py hace backup con la primera; clonar_demo_a_pruebas.py usa
# las dos). No hacen falta para correr la app.
# DEMO_DATABASE_URL=postgresql://...
# PRUEBAS_DATABASE_URL=postgresql://...

ANTHROPIC_API_KEY=pega-tu-clave-aca
PLATAFORMA_PASSWORD=elegí-una-clave-de-plataforma
SESSION_SECRET=una-cadena-larga-y-secreta
PLATAFORMA_CUIT=20000000000

# XSK (XSANDERS Security Kit, ver PLAN_XSK.md y xsk/). Solo en la PC de quien
# corre las evaluaciones; la app no las lee.
# XSK_ENTORNO_OBJETIVO=pruebas        # contra qué entorno pega Code por defecto
# RENDER_API_KEY=...                  # leer la configuración de los servicios
# CLOUDFLARE_API_TOKEN=...            # perímetro, cuando exista la cuenta

# Cierre de transición de R1 (usuarios de plataforma nominales). Por defecto
# el login genérico (20000000000) y el PIN de la landing están APAGADOS: se
# entra solo con usuario nominal. Reversibles para una emergencia (mientras
# no exista recuperación de clave por mail):
# LOGIN_GENERICO=1            # re-habilita el login genérico de plataforma
# PIN_ENTORNOS_HABILITADO=1   # re-habilita el PIN de /entornos

# Registro confirmado por mail y recuperación de clave (PLAN_REGISTRO.md).
# Sin RESEND_API_KEY + MAIL_REMITENTE el canal de mail queda apagado: el
# registro cae a nivel 1 (visible para el sindicato) y la recuperación deriva
# al sindicato. Sin TURNSTILE_SITE_KEY + TURNSTILE_SECRET no hay captcha.
# RESEND_API_KEY=re_...
# MAIL_REMITENTE=Colm3na <no-responder@avisos.colm3na.com.ar>
# TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET=0x...

# Laboratorio de modelos (/entornos → Herramientas, docs/LABORATORIO_MODELOS.md):
# claves de los OTROS proveedores para comparar con Claude. Sin ellas, sus
# modelos se ven en la lista pero no se pueden elegir. Ninguna ruta de la
# app las usa. La base URL es opcional (el catálogo trae una por defecto).
# DASHSCOPE_API_KEY=sk-...        # Alibaba Cloud Model Studio, región Singapur (Qwen 3.8)
# DASHSCOPE_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# MOONSHOT_API_KEY=sk-...         # platform.kimi.ai (Kimi K3 / K3.1 Pro)
# OPENAI_API_KEY=sk-...           # platform.openai.com (GPT-6.1 Sol / Terra, GPT-6 Luna / Astra)
