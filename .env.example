# DATABASE_URL: OBLIGATORIA. La app corre sobre Postgres y no tiene otro
# motor: sin esta variable no arranca. En desarrollo apunta al Postgres del
# docker-compose.yml de la raíz (`docker compose up -d`).
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# External Database URL de cada entorno, para los scripts de operación
# (promover_demo.py hace backup con la primera; clonar_demo_a_pruebas.py usa
# las dos). No hacen falta para correr la app.
# DEMO_DATABASE_URL=postgresql://...
# PRUEBAS_DATABASE_URL=postgresql://...

ANTHROPIC_API_KEY=pega-tu-clave-aca
PLATAFORMA_PASSWORD=elegí-una-clave-de-plataforma
SESSION_SECRET=una-cadena-larga-y-secreta
PLATAFORMA_CUIT=20000000000
