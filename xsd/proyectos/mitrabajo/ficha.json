  "idioma": "castellano rioplatense",
  "locale": "es-AR",
  "servidor": {
    "comando": ".venv/bin/uvicorn main:app --port {puerto}",
    "puerto": 8077,
    "salud": "/healthz",
    "nota": "Postgres local levantado (docker compose up -d o el hook de la nube) y alembic upgrade head."
  },
  "sesiones": {
    "comando": ".venv/bin/python xsd/proyectos/mitrabajo/sesiones.py {variante} {quien}",
    "dominio": "localhost",
