.env
__pycache__/
*.pyc
.venv/
data/reportes.json
data/validador.db

disenos/

# Artefactos de los robots E2E (videos, trazas, capturas): pesan MB por
# corrida y se regeneran solos -- ver e2e/README.md
e2e/resultados/
test-results/

# Dumps de la base de demo que hace promover_demo.py antes de promover
backups/
medicion_asistente/ultima_corrida.json

# Intermedio del generador de documentación técnica (lo rehace extraer.py)
docs/generador/datos.json

# Test de carga (carga/): artefactos generados por corridas, no versionar
carga/usuarios.csv
# Datos crudos del test de carga. Los NDJSON que escribe k6 pesan cientos de
# MB por corrida y NO van al repo; todo lo demás de carga/log/ (resumen.csv,
# servidor*.log, los summaries y el stdout de k6) SÍ se versiona: es la
# fuente contra la que audita carga/verificar.py, y sin ella el informe
# publicado deja de ser reproducible desde un clon limpio. Las ventanas de
# tiempo que hacían falta del NDJSON quedan cacheadas en carga/ventanas.json.
carga/log/*/test1_lecturas.json
carga/log/*/test2_recibos.json
carga/log/*/*.ndjson

# Modelos de OCR descargados para medir (PLAN_ENMASCARADO.md, bloque 2).
modelos_ocr/

# La medición guarda también las lecturas completas: pesadas y regenerables.
medicion_enmascarado/RESULTADO.json

# Mapa funcional generado por mapa_funcional.py: se rehace del código en
# segundos, no se versiona (ver CLAUDE.md).
mapa-funcional/

# Regularización de CUIL/CUIT (PLAN_CUIT_MOD11.md): la planilla lleva nombres de personas
# y el backup previo lleva la base entera. Ninguno de los dos se versiona.
regularizacion_cuit_*.csv
backup_regularizacion_*

# Skill impeccable (.claude/skills/impeccable/ORIGEN.md): lo que deja el
# detector y el modo live si alguien los prende en su PC. La configuración
# compartida (.impeccable/config.json) y los briefs sí se versionan.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/
.impeccable/review/
.impeccable/build/
.impeccable/critique/
.claude/settings.local.json
