 "rotulos": [
  {
   "t0": 3.0,
   "t1": 9.6,
   "h": "Josefina, afiliada a <b>La Bancaria</b>",
   "s": "Cada diciembre, el kit escolar: formulario en papel, fotocopias y una cola en la seccional."
  },
  {
   "t0": 10.6,
   "t1": 15.800000000000002,
   "h": "Su sindicato ya usa <b>Colm3na</b>",
   "s": "La app del afiliado: recibos, credencial, trámites, novedades y beneficios, con la marca del gremio."
  },
  {
   "t0": 17.000000000000004,
   "t1": 23.800000000000004,
   "h": "El <b>Asistente de trámites</b> de Colm3na",
   "s": "Alguien de Acción Social cuenta el trámite como se lo contaron: en lenguaje natural, sin programar."
  },
  {
   "t0": 24.800000000000004,
   "t1": 30.080000000000005,
   "h": "Un clic: <b>Analizar con IA</b>",
   "s": "La inteligencia artificial de Colm3na lee el relato y propone el trámite entero."
  },
  {
   "t0": 31.080000000000005,
   "t1": 37.470000000000006,
   "h": "La IA <b>lo entiende</b>",
   "s": "Para qué sirve, quién lo pide, quién lo revisa y cómo termina. Lo que infiere, marcado como «IA»."
  },
  {
   "t0": 38.470000000000006,
   "t1": 46.85000000000001,
   "h": "<b>Seis preguntas</b>, nada más",
   "s": "Cada una trae la respuesta recomendada ya puesta: se confirma con un clic, o se cambia."
  },
  {
   "t0": 47.85000000000001,
   "t1": 56.85000000000001,
   "h": "Los datos y <b>sus controles</b>",
   "s": "DNI del chico, constancia de alumno regular, una fecha de nacimiento que no puede ser futura."
  },
  {
   "t0": 57.85000000000001,
   "t1": 68.79000000000002,
   "h": "El circuito, <b>actor por actor</b>",
   "s": "El afiliado pide desde la app; Acción Social revisa la documentación, aprueba y avisa dónde retirar el kit."
  },
  {
   "t0": 69.79000000000002,
   "t1": 75.51000000000002,
   "h": "En minutos, <b>sin intervención técnica</b>",
   "s": "El trámite ya está publicado en la app del sindicato, con la marca de La Bancaria."
  },
  {
   "t0": 76.51000000000002,
   "t1": 86.46000000000001,
   "h": "Desde el celular, <b>en cinco minutos</b>",
   "s": "Los datos de Mateo, el DNI y la constancia adjuntos: Josefina envía desde el colectivo."
  },
  {
   "t0": 87.56000000000002,
   "t1": 96.22000000000001,
   "h": "Expediente numerado, <b>estado a la vista</b>",
   "s": "Y en la seccional, el pedido ya está en la bandeja de Acción Social: sin papel, sin cola."
  }
 ],
